90         /* Valid doses: EXDOSE > 0, or EXDOSE = 0 and EXTRT contains PLACEBO */
91         data ex_v;
92           set ex;
93           if EXDOSE > 0 or (EXDOSE = 0 and index(upcase(EXTRT), 'PLACEBO') > 0);
94           if length(strip(EXSTDTC)) >= 10 then stdt = input(substr(EXSTDTC, 1, 10), yymmdd10.);
95           if length(strip(EXENDTC)) >= 10 then endt = input(substr(EXENDTC, 1, 10), yymmdd10.);
96           format stdt endt date9.;
97         run;

