111        
112        /* Subject-level derivations, from the spec text */
113        data qc_adsl;
114          merge dm(in=a keep=USUBJID ARM ACTARM AGE) trt;
115          by USUBJID;
116          if a;
117          length TRT01P TRT01A $40 AGEGR1 $10 ITTFL SAFFL $1;
118          if ARM    ne 'Screen Failure' then TRT01P = ARM;
119          if ACTARM ne 'Screen Failure' then TRT01A = ACTARM;
120          if n(TRTSDT, TRTEDT) = 2 then TRTDURD = TRTEDT - TRTSDT + 1;
121          if      AGE < 65  then AGEGR1 = '<65';
122          else if AGE <= 80 then AGEGR1 = '65-80';
123          else                   AGEGR1 = '>80';
124          ITTFL = ifc(ARM ne 'Screen Failure', 'Y', 'N');
125          SAFFL = ifc(not missing(TRTSDT), 'Y', 'N');
126          keep USUBJID TRT01P TRT01A TRTSDT TRTEDT TRTDURD AGEGR1 ITTFL SAFFL;
127        run;

